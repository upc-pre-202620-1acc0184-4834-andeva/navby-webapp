# Copia este archivo a .env.local y completa los valores (.env.local nunca se versiona).
#
# OJO: toda variable VITE_* se incrusta en el bundle y la ve cualquiera.
# Aquí nunca van secretos: los secretos viven en navby-platform.

# Google Identity Services. Client ID público (no el secret) de tu cliente OAuth de
# desarrollo con origen autorizado http://localhost:5173. Es el mismo valor que
# GOOGLE_CLIENT_ID del .env de navby-platform. En producción: el cliente con origen
# https://navby.andeva.tech.
VITE_GOOGLE_CLIENT_ID=

# Cloudflare Turnstile: Site Key pública (el Secret Key va en navby-platform).
# Vacío = no carga el script externo y envía un token de prueba (local y e2e).
# Opcional en local: 1x00000000000000000000AA muestra el widget de prueba de Cloudflare.
# En producción: el Site Key real del widget de navby.andeva.tech.
VITE_TURNSTILE_SITE_KEY=

# Sitio web (navby-website): enlaces a Términos y Política de Privacidad del pie (RL-01).
# Local: navby-website con `pnpm dev`. Producción: https://navby.andeva.tech
VITE_WEBSITE_URL=http://localhost:4321

# Solo `pnpm dev`: a dónde reenvía el proxy de Vite las rutas /api.
# navby-platform en local escucha en el puerto 8000. En producción no se usa:
# el proxy de Vercel del website atiende /api.
VITE_API_PROXY_TARGET=http://localhost:8000
